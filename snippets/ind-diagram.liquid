{%- comment -%}
  Schematic, translatable infographics drawn as inline SVG. All wording and values come from
  section settings, so nothing is baked into an image and every language renders correctly.
  These are labelled schematics. They do not depict the product's exact appearance.
  Params: type ('lift' | 'transporter' | 'gate'), v1..v4 values, l1..l4 labels, caption
{%- endcomment -%}
<figure class="ind-diagram" aria-label="{{ caption | default: l1 | escape }}">
  {%- case type -%}
    {%- when 'lift' -%}
      <svg viewBox="0 0 520 560" role="img" aria-labelledby="dg-{{ uid }}">
        <title id="dg-{{ uid }}">{{ l1 }} {{ v1 }}, {{ l2 }} {{ v2 }}</title>
        <line x1="20" y1="520" x2="500" y2="520" class="d-line" stroke-width="2"/>
        <g class="d-muted" stroke-width="1" stroke-dasharray="4 6">
          <line x1="80" y1="70" x2="440" y2="70"/>
        </g>
        <!-- masts -->
        <rect x="150" y="70" width="18" height="430" class="d-fill-muted" stroke="currentColor" stroke-width="2"/>
        <rect x="352" y="70" width="18" height="430" class="d-fill-muted" stroke="currentColor" stroke-width="2"/>
        <!-- base + castors -->
        <rect x="130" y="490" width="260" height="16" rx="2" class="d-accent"/>
        <circle cx="150" cy="512" r="8" fill="none" stroke="currentColor" stroke-width="2"/>
        <circle cx="370" cy="512" r="8" fill="none" stroke="currentColor" stroke-width="2"/>
        <!-- cable -->
        <line x1="190" y1="70" x2="190" y2="200" stroke="currentColor" stroke-width="1.5"/>
        <line x1="330" y1="70" x2="330" y2="200" stroke="currentColor" stroke-width="1.5"/>
        <!-- platform -->
        <rect x="140" y="200" width="240" height="14" rx="2" class="d-accent"/>
        <rect x="200" y="140" width="120" height="60" rx="3" class="d-fill-soft d-stroke-accent" stroke-width="2"/>
        <text x="260" y="177" text-anchor="middle" style="font-size:18px;font-weight:800">{{ v2 }}</text>
        <!-- height dimension -->
        <line x1="450" y1="70" x2="450" y2="505" class="d-stroke-accent" stroke-width="2.5"/>
        <path d="M440 84 450 66 460 84" fill="none" class="d-stroke-accent" stroke-width="2.5"/>
        <path d="M440 492 450 510 460 492" fill="none" class="d-stroke-accent" stroke-width="2.5"/>
        <text x="440" y="280" text-anchor="end" class="d-value d-accent">{{ v1 }}</text>
        <text x="440" y="304" text-anchor="end" class="d-label">{{ l1 }}</text>
        <!-- load label -->
        <text x="70" y="160" text-anchor="middle" class="d-value">{{ v2 }}</text>
        <text x="70" y="184" text-anchor="middle" class="d-label">{{ l2 }}</text>
        {%- if v3 != blank -%}
          <text x="70" y="400" text-anchor="middle" class="d-value" style="font-size:22px">{{ v3 }}</text>
          <text x="70" y="422" text-anchor="middle" class="d-label">{{ l3 }}</text>
        {%- endif -%}
        {%- if v4 != blank -%}
          <text x="260" y="550" text-anchor="middle" class="d-label">{{ v4 }} · {{ l4 }}</text>
        {%- endif -%}
      </svg>
    {%- when 'transporter' -%}
      <svg viewBox="0 0 600 380" role="img" aria-labelledby="dg-{{ uid }}">
        <title id="dg-{{ uid }}">{{ l1 }} {{ v1 }}, {{ l2 }} {{ v2 }}, {{ l3 }} {{ v3 }}</title>
        <line x1="20" y1="300" x2="580" y2="300" class="d-line" stroke-width="2"/>
        <!-- deck + load -->
        <rect x="90" y="190" width="350" height="22" rx="3" class="d-accent"/>
        <rect x="90" y="140" width="350" height="50" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="2 8"/>
        <rect x="140" y="120" width="90" height="70" rx="3" class="d-fill-soft d-stroke-accent" stroke-width="2"/>
        <rect x="240" y="140" width="70" height="50" rx="3" class="d-fill-soft d-stroke-accent" stroke-width="2"/>
        <!-- chassis + front column -->
        <rect x="440" y="150" width="34" height="62" rx="3" class="d-fill-muted" stroke="currentColor" stroke-width="2"/>
        <line x1="470" y1="150" x2="490" y2="70" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
        <line x1="470" y1="70" x2="512" y2="70" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
        <!-- wheels -->
        <circle cx="150" cy="262" r="38" fill="none" stroke="currentColor" stroke-width="5"/>
        <circle cx="150" cy="262" r="10" class="d-accent"/>
        <circle cx="410" cy="262" r="38" fill="none" stroke="currentColor" stroke-width="5"/>
        <circle cx="410" cy="262" r="10" class="d-accent"/>
        <line x1="90" y1="212" x2="470" y2="212" stroke="currentColor" stroke-width="2"/>
        <!-- length dimension -->
        <line x1="90" y1="340" x2="512" y2="340" class="d-stroke-accent" stroke-width="2"/>
        <line x1="90" y1="330" x2="90" y2="350" class="d-stroke-accent" stroke-width="2"/>
        <line x1="512" y1="330" x2="512" y2="350" class="d-stroke-accent" stroke-width="2"/>
        <text x="300" y="372" text-anchor="middle" class="d-label"><tspan class="d-accent" style="font-weight:800">{{ v1 }}</tspan>  {{ l1 }}</text>
        <!-- deck height -->
        <line x1="48" y1="190" x2="48" y2="300" class="d-stroke-accent" stroke-width="2"/>
        <line x1="38" y1="190" x2="58" y2="190" class="d-stroke-accent" stroke-width="2"/>
        <text x="40" y="246" text-anchor="end" class="d-label" transform="rotate(-90 40 246)" dy="-6">{{ v2 }} {{ l2 }}</text>
        <!-- load + platform -->
        <text x="265" y="96" text-anchor="middle" class="d-value">{{ v3 }}</text>
        <text x="265" y="116" text-anchor="middle" class="d-label">{{ l3 }}</text>
        {%- if v4 != blank -%}
          <text x="265" y="34" text-anchor="middle" class="d-label">{{ l4 }}: <tspan style="font-weight:800" class="d-accent">{{ v4 }}</tspan></text>
        {%- endif -%}
      </svg>
    {%- when 'gate' -%}
      <svg viewBox="0 0 520 420" role="img" aria-labelledby="dg-{{ uid }}">
        <title id="dg-{{ uid }}">{{ l1 }} {{ v1 }}, {{ l2 }} {{ v2 }}</title>
        <!-- path -->
        <rect x="150" y="20" width="220" height="380" class="d-fill-muted"/>
        <!-- gate posts -->
        <rect x="104" y="196" width="46" height="28" rx="2" fill="currentColor"/>
        <rect x="370" y="196" width="46" height="28" rx="2" fill="currentColor"/>
        <line x1="40" y1="210" x2="104" y2="210" stroke="currentColor" stroke-width="4"/>
        <line x1="416" y1="210" x2="480" y2="210" stroke="currentColor" stroke-width="4"/>
        <!-- vehicle top view -->
        <rect x="157" y="230" width="206" height="150" rx="10" class="d-fill-soft d-stroke-accent" stroke-width="3"/>
        <line x1="185" y1="230" x2="185" y2="380" class="d-stroke-accent" stroke-dasharray="3 6"/>
        <line x1="335" y1="230" x2="335" y2="380" class="d-stroke-accent" stroke-dasharray="3 6"/>
        <path d="M260 120 260 220" class="d-stroke-accent" stroke-width="3" stroke-linecap="round"/>
        <path d="M246 136 260 116 274 136" fill="none" class="d-stroke-accent" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- passage dimension -->
        <line x1="150" y1="170" x2="370" y2="170" stroke="currentColor" stroke-width="2"/>
        <line x1="150" y1="160" x2="150" y2="180" stroke="currentColor" stroke-width="2"/>
        <line x1="370" y1="160" x2="370" y2="180" stroke="currentColor" stroke-width="2"/>
        <text x="260" y="160" text-anchor="middle" class="d-label">{{ l2 }} <tspan style="font-weight:800;fill:currentColor">{{ v2 }}</tspan></text>
        <!-- vehicle width -->
        <text x="260" y="316" text-anchor="middle" class="d-value d-accent">{{ v1 }}</text>
        <text x="260" y="340" text-anchor="middle" class="d-label">{{ l1 }}</text>
      </svg>
  {%- endcase -%}
  {%- if caption != blank -%}<figcaption class="ind-note" style="text-align:center">{{ caption }}</figcaption>{%- endif -%}
</figure>
