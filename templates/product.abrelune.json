    "faq": {
      "type": "ind-faq",
      "settings": {
        "scheme": "paper",
        "accent": "#4f6b2a",
        "layout": "stacked",
        "single": true,
        "open_first": true,
        "schema": true,
        "eyebrow": "FAQ",
        "heading": "Questions about Abrelune",
        "text": "<p>Everything you need to know before you order.</p>",
        "btn_label": "Contact us",
        "btn_link": "shopify://pages/contact"
      },
      "blocks": {
        "qa_116": {
          "type": "qa",
          "settings": {
            "q": "How much can Abrelune carry?",
            "a": "<p>Up to 450 kg. On steep slopes and soft ground, reduce the load for safe driving.</p>"
          }
        },
        "qa_117": {
          "type": "qa",
          "settings": {
            "q": "What motor does it have?",
            "a": "<p>A brushless 1000 W electric motor with two-wheel drive.</p>"
          }
        },
        "qa_118": {
          "type": "qa",
          "settings": {
            "q": "What battery does it use?",
            "a": "<p>A sealed 48 V lead-acid battery system, with a battery indicator that always shows the charge left.</p>"
          }
        },
        "qa_119": {
          "type": "qa",
          "settings": {
            "q": "How far can I drive on one charge?",
            "a": "<p>About 24–27 km, depending on load, surface, gradient and battery condition.</p>"
          }
        },
        "qa_120": {
          "type": "qa",
          "settings": {
            "q": "How long does charging take?",
            "a": "<p>A full charge takes about 4–5 hours.</p>"
          }
        },
        "qa_121": {
          "type": "qa",
          "settings": {
            "q": "What terrain can it handle?",
            "a": "<p>Two-wheel drive gives traction on grass, gravel, paths and uneven ground. Reduce the load on steep slopes and soft surfaces.</p>"
          }
        },
        "qa_122": {
          "type": "qa",
          "settings": {
            "q": "Will it fit through my gate?",
            "a": "<p>Abrelune is about 79 cm wide. We recommend a passage of at least 84 cm.</p>"
          }
        },
        "qa_123": {
          "type": "qa",
          "settings": {
            "q": "Can I drive it on public roads?",
            "a": "<p>Abrelune is intended for private land such as plots, farms and work areas. With a top speed of about 24 km/h, vehicle classification rules may apply. Always check local regulations before driving outside private property.</p>"
          }
        },
        "qa_124": {
          "type": "qa",
          "settings": {
            "q": "What maintenance does it need?",
            "a": "<p>Keep the battery charged between uses, check the tyres and controls regularly, and follow the user manual supplied with Abrelune.</p>"
          }
        },
        "qa_125": {
          "type": "qa",
          "settings": {
            "q": "What's included?",
            "a": "<p>The Abrelune transporter, a 48 V battery system, a charger, and the user manual with safety instructions.</p>"
          }
        },
        "qa_126": {
          "type": "qa",
          "settings": {
            "q": "How long does delivery take?",
            "a": "<p>Available delivery options, costs and estimated delivery times are shown at checkout before you pay. You'll get a confirmation email as soon as your order ships.</p>"
          }
        },
        "qa_127": {
          "type": "qa",
          "settings": {
            "q": "Is Abrelune covered if something goes wrong?",
            "a": "<p>If anything isn't right, contact our support team with your order number and we'll help. The terms that apply to your purchase are set out in our <a href=\"/policies/terms-of-service\">terms of service</a>.</p>"
          }
        },
        "qa_128": {
          "type": "qa",
          "settings": {
            "q": "Can I return Abrelune?",
            "a": "<p>Returns follow our <a href=\"/policies/refund-policy\">refund policy</a>. Contact our team first and we'll guide you through the process.</p>"
          }
        }
      },
