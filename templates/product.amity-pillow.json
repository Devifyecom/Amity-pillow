    "faq": {
      "type": "amity-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How Easy Is It to Set Up?",
            "answer": "<p>Take it out of the packaging and give it a few hours to fully expand. The cover is already on, so it's ready for bed the same night.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Which Sleep Positions Does Amity Suit?",
            "answer": "<p>Amity is made for back and side sleepers. Each has its own face: lower for your back, higher for your side. Many people who switch positions during the night like having both in one pillow.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How Do I Flip It, and Which Side Is Which?",
            "answer": "<p>The lower face is for back sleeping and the higher face is for side sleeping. Keep the raised edge under your neck and turn the pillow over to switch heights. No stacking needed.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "How Do I Clean the Cover?",
            "answer": "<p>Unzip the cover, hand wash it in cold water with a mild detergent and let it air dry. Don't wash the foam core. Spot clean it if needed.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "What If It Is Not for Me?",
            "answer": "<p>You have 30 days to return unopened pillows. If yours arrives damaged, defective or not as described, we'll replace it or refund you. Just reach out to our support team.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "How Long Does Shipping Take?",
            "answer": "<p>Shipping is free. You'll see the ship-by date just above the Add to cart button, and we email a tracking link as soon as your order is on its way.</p>"
          }
        }
