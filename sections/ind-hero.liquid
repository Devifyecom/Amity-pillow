{%- render 'ind-assets' -%}
<section class="ind ind-hero" data-section-id="{{ section.id }}" style="--hero-shade: {{ section.settings.shade | divided_by: 100.0 }}; --hero-h: {{ section.settings.height }}vh; --hero-h-mobile: {{ section.settings.height_mobile }}vh;">
  <div class="ind-hero__bg">
    {%- if section.settings.image_mobile != blank -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
        {%- render 'ind-image', image: section.settings.image, sizes: '100vw', loading: 'eager' -%}
      </picture>
    {%- else -%}
      {%- render 'ind-image', image: section.settings.image, sizes: '100vw', loading: 'eager', label: 'Hero image: real product in a work environment' -%}
    {%- endif -%}
  </div>
  <div class="ind-container ind-hero__inner">
    <div class="ind-hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="ind-eyebrow" style="color:#fff">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="ind-h1">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="ind-lead">{{ section.settings.text }}</div>{%- endif -%}
      <div class="ind-actions">
        {%- if section.settings.btn1_label != blank -%}<a class="ind-btn ind-btn--accent ind-btn--lg" href="{{ section.settings.btn1_link | default: '#' }}">{{ section.settings.btn1_label }} {% render 'ind-icon', name: 'arrow-right' %}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a class="ind-btn ind-btn--outline ind-btn--lg" href="{{ section.settings.btn2_link | default: '#' }}">{{ section.settings.btn2_label }}</a>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <dl class="ind-hero__stats">
          {%- for block in section.blocks -%}
            <div class="ind-hero__stat" {{ block.shopify_attributes }}><dt class="ind-visually-hidden">{{ block.settings.label }}</dt><dd><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></dd></div>
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IND hero",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Use real product photography. Landscape, 2400×1400 px or larger." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)", "info": "Portrait, 1100×1600 px." },
    { "type": "range", "id": "shade", "label": "Image overlay", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 70 },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 80 },
    { "type": "range", "id": "height_mobile", "label": "Mobile height", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 80 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Professional equipment" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Wrap words in <em></em> to highlight them.", "default": "Lift higher. <em>Carry more.</em> Work smarter." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Electric lifting and transport equipment that takes heavy loads off your team, from the scaffold to the yard.</p>" },
    { "type": "text", "id": "btn1_label", "label": "Primary button", "default": "Shop Selo" },
    { "type": "url", "id": "btn1_link", "label": "Primary link" },
    { "type": "text", "id": "btn2_label", "label": "Secondary button", "default": "Shop Abrelune" },
    { "type": "url", "id": "btn2_link", "label": "Secondary link" }
  ],
  "blocks": [
    { "type": "stat", "name": "Key figure", "settings": [
      { "type": "text", "id": "value", "label": "Value", "default": "500 kg" },
      { "type": "text", "id": "label", "label": "Label", "default": "Lifting capacity" }
    ] }
  ],
  "presets": [ { "name": "IND hero" } ]
}
{% endschema %}
