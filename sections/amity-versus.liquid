{%- render 'amity-assets' -%}

<section
  class="am am-section am-bg--{{ section.settings.background }}"
  style="--am-pt: {{ section.settings.padding_top }}px; --am-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="am-container am-container--narrow">
    {%- if section.settings.heading != blank -%}
      <h2 class="am-heading am-heading--center">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="am-vs__media">
      <div class="am-vs__img">
        {%- if section.settings.image_left != blank -%}
          {{ section.settings.image_left | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420, 640, 900', sizes: '(min-width: 990px) 422px, 50vw' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'am-placeholder' }}
        {%- endif -%}
      </div>
      <div class="am-vs__img">
        {%- if section.settings.image_right != blank -%}
          {{ section.settings.image_right | image_url: width: 900 | image_tag: loading: 'lazy', widths: '420, 640, 900', sizes: '(min-width: 990px) 422px, 50vw' }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'am-placeholder' }}
        {%- endif -%}
      </div>
      {%- if section.settings.badge != blank -%}
        <span class="am-vs__badge">{{ section.settings.badge }}</span>
      {%- endif -%}
    </div>

    {%- if section.settings.card_title != blank or section.settings.card_text != blank -%}
      <div class="am-vs__card">
        <div class="am-vs__card-head">
          <span class="am-vs__card-icon">
            {%- if section.settings.card_icon != blank -%}
              {{ section.settings.card_icon | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
            {%- else -%}
              {%- render 'amity-icon', icon: 'moon-pillow' -%}
            {%- endif -%}
          </span>
          <h3 class="am-vs__card-title">{{ section.settings.card_title }}</h3>
        </div>
        <p class="am-vs__card-text">{{ section.settings.card_text }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Amity before & after",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Imagine Waking Up Rested, Not Restless." },
    { "type": "image_picker", "id": "image_left", "label": "Left image (with Amity)" },
    { "type": "image_picker", "id": "image_right", "label": "Right image (without)" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "VS" },
    { "type": "image_picker", "id": "card_icon", "label": "Card icon", "info": "Optional — a line icon is used by default." },
    { "type": "text", "id": "card_title", "label": "Card title", "default": "Shaped for Settled, Restful Sleep" },
    { "type": "textarea", "id": "card_text", "label": "Card text", "default": "Flat pillows leave your neck hanging, so you keep shifting. Amity cradles your head and supports your neck." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "gray", "label": "Light gray" },
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Amity before & after" }]
}
{% endschema %}
