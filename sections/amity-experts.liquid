{%- render 'amity-assets' -%}

<section
  class="am am-section am-bg--{{ section.settings.background }}"
  style="--am-pt: {{ section.settings.padding_top }}px; --am-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="am-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="am-heading am-heading--center">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="am-experts">
      {%- for block in section.blocks -%}
        <figure class="am-expert" style="margin: 0;" {{ block.shopify_attributes }}>
          <div class="am-expert__img">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag: loading: 'lazy', widths: '330, 500, 700', sizes: '(min-width: 990px) 330px, 78vw', alt: block.settings.name
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'am-placeholder' }}
            {%- endif -%}
          </div>
          {%- if block.settings.quote != blank -%}
            <blockquote class="am-expert__quote" style="margin: 0;">"{{ block.settings.quote }}"</blockquote>
          {%- endif -%}
          <figcaption>
            <p class="am-expert__name">{{ block.settings.name }}</p>
            <p class="am-expert__role">{{ block.settings.role }}</p>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Amity expert quotes",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Only feature real professionals who have agreed to be quoted, and keep quotes about comfort and design rather than health outcomes."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the Experts Say" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "gray", "label": "Light gray" },
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "gray"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Portrait" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Add a genuine quote from a professional who has tried Amity." },
        { "type": "text", "id": "name", "label": "Name", "default": "Expert name" },
        { "type": "text", "id": "role", "label": "Role and location", "default": "Specialty, City" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Amity expert quotes",
      "blocks": [{ "type": "expert" }, { "type": "expert" }, { "type": "expert" }]
    }
  ]
}
{% endschema %}
