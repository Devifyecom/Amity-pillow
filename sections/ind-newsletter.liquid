{%- render 'ind-assets' -%}
<section class="ind ind--{{ section.settings.scheme }} ind-section ind-section--tight" data-section-id="{{ section.id }}">
  <div class="ind-container">
    <div class="ind-news">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="ind-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="ind-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="ind-head__text">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      <div>
        {%- assign form_id = 'IndNews-' | append: section.id -%}
        {%- form 'customer', id: form_id, class: 'ind-news__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="ind-visually-hidden" for="IndNewsEmail-{{ section.id }}">{{ 'ind.general.email' | t }}</label>
          <input id="IndNewsEmail-{{ section.id }}" class="ind-news__input" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'ind.general.email' | t }}">
          <button class="ind-btn ind-btn--accent" type="submit">{{ 'ind.general.subscribe' | t }}</button>
          {%- if form.posted_successfully? -%}<p class="ind-news__msg ind-news__msg--ok" role="status" style="width:100%">{{ 'ind.general.newsletter_success' | t }}</p>{%- endif -%}
          {%- if form.errors -%}<p class="ind-news__msg" role="alert" style="width:100%">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endform -%}
        {%- if section.settings.disclaimer != blank -%}<p class="ind-note">{{ section.settings.disclaimer }}</p>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "IND newsletter",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Colour scheme", "options": [ { "value": "paper", "label": "White" }, { "value": "sand", "label": "Warm neutral" }, { "value": "dark", "label": "Graphite" }, { "value": "accent", "label": "Accent" } ], "default": "dark" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product news and campaign alerts" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Be the first to hear about new equipment and seasonal offers.</p>" },
    { "type": "text", "id": "disclaimer", "label": "Small print", "default": "You can unsubscribe at any time." }
  ],
  "presets": [ { "name": "IND newsletter" } ]
}
{% endschema %}
