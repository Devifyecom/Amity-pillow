{%- render 'ind-assets' -%}
<section class="ind ind--{{ section.settings.scheme }} ind-section" data-section-id="{{ section.id }}"{% if section.settings.accent != blank %} style="--ind-accent: {{ section.settings.accent }}"{% endif %}>
  <div class="ind-container">
    <div class="ind-head ind-head--center">
      {%- if section.settings.eyebrow != blank -%}<p class="ind-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ind-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="ind-head__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <ul class="ind-included" style="--cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }}" role="list">
      {%- for block in section.blocks -%}
        <li class="ind-included__item ind-reveal" {{ block.shopify_attributes }}>
          <div class="ind-included__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 400, 600', sizes: '(min-width: 990px) 22vw, 45vw', alt: block.settings.title }}
            {%- else -%}
              {%- render 'ind-icon', name: block.settings.icon -%}
            {%- endif -%}
          </div>
          {%- if block.settings.qty != blank -%}<span class="ind-included__qty">{{ block.settings.qty }}</span>{%- endif -%}
          <h3 class="ind-included__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="ind-included__text">{{ block.settings.text }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.note != blank -%}<p class="ind-note ind-center">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "IND what's included",
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "List only the items your supplier confirms are in the box." },
    { "type": "select", "id": "scheme", "label": "Colour scheme", "options": [ { "value": "paper", "label": "White" }, { "value": "sand", "label": "Warm neutral" }, { "value": "stone", "label": "Stone" } ], "default": "sand" },
    { "type": "color", "id": "accent", "label": "Accent colour override" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the box" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's included" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Footnote" }
  ],
  "blocks": [
    { "type": "item", "name": "Item", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "select", "id": "icon", "label": "Icon (when no image)", "options": [{"value": "none", "label": "None"}, {"value": "check-circle", "label": "Check"}, {"value": "weight", "label": "Weight / load"}, {"value": "height", "label": "Height"}, {"value": "remote", "label": "Remote control"}, {"value": "shield", "label": "Safety shield"}, {"value": "layers", "label": "Steel / layers"}, {"value": "wheel", "label": "Castor wheel"}, {"value": "rotate", "label": "360\u00b0 rotation"}, {"value": "bolt", "label": "Power"}, {"value": "motor", "label": "Motor"}, {"value": "battery", "label": "Battery"}, {"value": "plug", "label": "Charger / plug"}, {"value": "clock", "label": "Clock / time"}, {"value": "truck", "label": "Delivery"}, {"value": "return", "label": "Returns"}, {"value": "box", "label": "Package"}, {"value": "ruler", "label": "Ruler"}, {"value": "width", "label": "Width"}, {"value": "gauge", "label": "Gauge"}, {"value": "speed", "label": "Speed"}, {"value": "route", "label": "Range / route"}, {"value": "terrain", "label": "Terrain"}, {"value": "tools", "label": "Tools"}, {"value": "wrench", "label": "Maintenance"}, {"value": "brick", "label": "Bricks / materials"}, {"value": "wood", "label": "Firewood"}, {"value": "leaf", "label": "Garden"}, {"value": "stairs", "label": "Stairs / height access"}, {"value": "grip", "label": "Non-slip platform"}, {"value": "cable", "label": "Steel cable"}, {"value": "brake", "label": "Brake"}, {"value": "light", "label": "LED light"}, {"value": "horn", "label": "Horn"}, {"value": "warning", "label": "Warning"}, {"value": "award", "label": "Warranty / quality"}, {"value": "support", "label": "Support"}, {"value": "lock", "label": "Secure checkout"}, {"value": "tag", "label": "Price tag"}, {"value": "percent", "label": "Discount"}, {"value": "calendar", "label": "Calendar"}, {"value": "globe", "label": "Worldwide"}], "default": "box" },
      { "type": "text", "id": "qty", "label": "Quantity", "default": "1×" },
      { "type": "text", "id": "title", "label": "Title", "default": "Item" },
      { "type": "text", "id": "text", "label": "Description" }
    ] }
  ],
  "presets": [ { "name": "IND what's included", "blocks": [ { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
