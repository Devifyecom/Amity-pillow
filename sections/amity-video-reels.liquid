{%- render 'amity-assets' -%}

<section
  class="am am-section am-bg--{{ section.settings.background }}"
  style="--am-pt: {{ section.settings.padding_top }}px; --am-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="am-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="am-heading am-heading--center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="am-subheading am-subheading--center">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="am-reels">
      {%- for block in section.blocks -%}
        <am-reel class="am-reel" {{ block.shopify_attributes }}>
          {%- if block.settings.video != blank -%}
            {{
              block.settings.video
              | video_tag: playsinline: true, loop: true, muted: true, preload: 'metadata', image_size: '600x'
            }}
            <button type="button" class="am-reel__sound" data-sound aria-label="Toggle sound">
              {%- render 'amity-icon', icon: 'sound' -%}
            </button>
            <button type="button" class="am-reel__play" data-play aria-label="Play video">
              {%- render 'amity-icon', icon: 'play' -%}
            </button>
          {%- elsif block.settings.poster != blank -%}
            {{ block.settings.poster | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.poster.alt }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'am-placeholder' }}
            <span class="am-reel__sound" aria-hidden="true">{% render 'amity-icon', icon: 'sound' %}</span>
            <span class="am-reel__play" aria-hidden="true">{% render 'amity-icon', icon: 'play' %}</span>
          {%- endif -%}
        </am-reel>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Amity video reels",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See Amity in Action" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tap a clip to watch with sound." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "gray", "label": "Light gray" },
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "gray"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Vertical 9:16 clips look best." },
        { "type": "image_picker", "id": "poster", "label": "Fallback image" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Amity video reels",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
