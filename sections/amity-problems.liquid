{%- render 'amity-assets' -%}

<section
  class="am am-section am-bg--{{ section.settings.background }}"
  style="--am-pt: {{ section.settings.padding_top }}px; --am-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="am-container">
    <div class="am-prob__top">
      <div class="am-prob__img">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '416, 640, 900', sizes: '(min-width: 990px) 416px, 100vw' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'am-placeholder' }}
        {%- endif -%}
      </div>
      <div>
        <h2 class="am-heading am-prob__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="am-prob__text">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="am-cards3 am-prob__cards">
        {%- for block in section.blocks -%}
          <div class="am-pcard" {{ block.shopify_attributes }}>
            <div class="am-pcard__img">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 295px, 100vw' }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'am-placeholder' }}
              {%- endif -%}
            </div>
            <div class="am-pcard__body">
              <h3 class="am-pcard__title">{{ block.settings.title }}</h3>
              <p class="am-pcard__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Amity problem cards",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Your Pillow Matters More Than You Think" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A flat pillow leaves your neck hanging and keeps you tossing. The right shape lets you settle." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "gray", "label": "Light gray" },
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "cream"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Tossing and Turning?" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "No neck support, so you shift all night." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Amity problem cards",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
