{%- render 'amity-assets' -%}

<section
  class="am am-section am-bg--{{ section.settings.background }}"
  style="--am-pt: {{ section.settings.padding_top }}px; --am-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="am-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="am-heading am-heading--center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="am-subheading am-subheading--center am-toggle__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <am-tabs class="am-toggle" data-active="0">
        <div class="am-toggle__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          <span class="am-toggle__pill" aria-hidden="true"></span>
          {%- for block in section.blocks limit: 2 -%}
            <button
              type="button"
              class="am-toggle__tab"
              role="tab"
              id="AmityTab-{{ block.id }}"
              aria-controls="AmityPanel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{ block.settings.tab_label }}
            </button>
          {%- endfor -%}
        </div>

        <div class="am-toggle__card">
          {%- for block in section.blocks limit: 2 -%}
            <div
              class="am-toggle__panel"
              role="tabpanel"
              id="AmityPanel-{{ block.id }}"
              aria-labelledby="AmityTab-{{ block.id }}"
              {% unless forloop.first %}hidden{% endunless %}
              {{ block.shopify_attributes }}
            >
              <div class="am-toggle__media">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1120
                    | image_tag: loading: 'lazy', widths: '560, 840, 1120', sizes: '(min-width: 600px) 560px, 100vw'
                  }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'am-placeholder' }}
                {%- endif -%}
              </div>
              <div class="am-toggle__body">
                <h3 class="am-toggle__title">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="am-toggle__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </am-tabs>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Amity sleep toggle",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Which Side Is for You?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tap how you sleep. Flip the pillow to that face." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "gray", "label": "Light gray" },
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "gray"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "position",
      "name": "Sleep position",
      "settings": [
        { "type": "text", "id": "tab_label", "label": "Tab label", "default": "Back Sleeper" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Use the Lower Face" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Lay it lower side up with the raised edge under your neck, and let your head settle into the center cradle." }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Amity sleep toggle",
      "blocks": [
        { "type": "position" },
        {
          "type": "position",
          "settings": {
            "tab_label": "Side Sleeper",
            "title": "Use the Higher Face",
            "text": "Flip it higher side up so the taller edge fills the space above your shoulder, with room for your arm underneath."
          }
        }
      ]
    }
  ]
}
{% endschema %}
