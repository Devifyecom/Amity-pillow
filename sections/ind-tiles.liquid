{%- render 'ind-assets' -%}
<section class="ind ind--{{ section.settings.scheme }} ind-section" data-section-id="{{ section.id }}"{% if section.settings.accent != blank %} style="--ind-accent: {{ section.settings.accent }}"{% endif %}>
  <div class="ind-container">
    <div class="ind-head{% if section.settings.center %} ind-head--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}<p class="ind-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="ind-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="ind-head__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <ul class="ind-tiles{% if section.settings.wide %} ind-tiles--wide{% elsif section.settings.square %} ind-tiles--square{% endif %}" style="--cols: {{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        <li class="ind-tile ind-reveal" {{ block.shopify_attributes }}>
          {%- render 'ind-image', image: block.settings.image, sizes: '(min-width: 990px) 25vw, 80vw', label: block.settings.title, icon: block.settings.icon -%}
          <div class="ind-tile__body">
            {%- if block.settings.icon != 'none' -%}<span class="ind-icon-tile" style="background:rgba(255,255,255,.14);color:#fff;margin-bottom:12px;width:44px;height:44px">{% render 'ind-icon', name: block.settings.icon %}</span>{%- endif -%}
            <h3 class="ind-tile__title">{% if block.settings.link != blank %}<a href="{{ block.settings.link }}" style="text-decoration:none">{{ block.settings.title }}</a>{% else %}{{ block.settings.title }}{% endif %}</h3>
            {%- if block.settings.text != blank -%}<p class="ind-tile__text">{{ block.settings.text }}</p>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "IND applications",
  "max_blocks": 8,
  "settings": [
    { "type": "select", "id": "scheme", "label": "Colour scheme", "options": [ { "value": "paper", "label": "White" }, { "value": "sand", "label": "Warm neutral" }, { "value": "dark", "label": "Graphite" }, { "value": "ink", "label": "Ink" } ], "default": "paper" },
    { "type": "color", "id": "accent", "label": "Accent colour override" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "wide", "label": "Landscape tiles", "default": false },
    { "type": "checkbox", "id": "square", "label": "Square tiles", "default": false },
    { "type": "checkbox", "id": "center", "label": "Centre heading", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for real work" },
    { "type": "richtext", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "tile", "name": "Application", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "none", "label": "None"}, {"value": "check-circle", "label": "Check"}, {"value": "weight", "label": "Weight / load"}, {"value": "height", "label": "Height"}, {"value": "remote", "label": "Remote control"}, {"value": "shield", "label": "Safety shield"}, {"value": "layers", "label": "Steel / layers"}, {"value": "wheel", "label": "Castor wheel"}, {"value": "rotate", "label": "360\u00b0 rotation"}, {"value": "bolt", "label": "Power"}, {"value": "motor", "label": "Motor"}, {"value": "battery", "label": "Battery"}, {"value": "plug", "label": "Charger / plug"}, {"value": "clock", "label": "Clock / time"}, {"value": "truck", "label": "Delivery"}, {"value": "return", "label": "Returns"}, {"value": "box", "label": "Package"}, {"value": "ruler", "label": "Ruler"}, {"value": "width", "label": "Width"}, {"value": "gauge", "label": "Gauge"}, {"value": "speed", "label": "Speed"}, {"value": "route", "label": "Range / route"}, {"value": "terrain", "label": "Terrain"}, {"value": "tools", "label": "Tools"}, {"value": "wrench", "label": "Maintenance"}, {"value": "brick", "label": "Bricks / materials"}, {"value": "wood", "label": "Firewood"}, {"value": "leaf", "label": "Garden"}, {"value": "stairs", "label": "Stairs / height access"}, {"value": "grip", "label": "Non-slip platform"}, {"value": "cable", "label": "Steel cable"}, {"value": "brake", "label": "Brake"}, {"value": "light", "label": "LED light"}, {"value": "horn", "label": "Horn"}, {"value": "warning", "label": "Warning"}, {"value": "award", "label": "Warranty / quality"}, {"value": "support", "label": "Support"}, {"value": "lock", "label": "Secure checkout"}, {"value": "tag", "label": "Price tag"}, {"value": "percent", "label": "Discount"}, {"value": "calendar", "label": "Calendar"}, {"value": "globe", "label": "Worldwide"}], "default": "none" },
      { "type": "text", "id": "title", "label": "Title", "default": "Application" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ],
  "presets": [ { "name": "IND applications", "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
