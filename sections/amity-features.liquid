{%- render 'amity-assets' -%}

<section
  class="am am-section am-bg--{{ section.settings.background }}"
  style="--am-pt: {{ section.settings.padding_top }}px; --am-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="am-container">
    <div class="am-feat__top">
      <div class="am-feat__visual">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '300px' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'am-placeholder' }}
        {%- endif -%}
      </div>
      <h2 class="am-heading am-feat__heading">{{ section.settings.heading }}</h2>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="am-cards3 am-feat__cards">
        {%- for block in section.blocks -%}
          <div class="am-fcard" {{ block.shopify_attributes }}>
            <div class="am-fcard__head">
              <span class="am-fcard__icon">
                {%- if block.settings.icon_image != blank -%}
                  {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {%- render 'amity-icon', icon: block.settings.icon -%}
                {%- endif -%}
              </span>
              <h3 class="am-fcard__title">{{ block.settings.title }}</h3>
            </div>
            <p class="am-fcard__text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Amity features",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product cut-out image", "info": "Transparent PNG works best." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "3 Ways Amity Changes How You Rest" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "gray", "label": "Light gray" },
        { "value": "cream", "label": "Cream" },
        { "value": "white", "label": "White" }
      ],
      "default": "gray"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "flip", "label": "Flip" },
            { "value": "neck", "label": "Neck" },
            { "value": "arm", "label": "Arm room" }
          ],
          "default": "flip"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Flip It to Fit How You Sleep" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "A lower face for your back, a higher one for your side. Keep whichever feels natural." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Amity features",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
